target/

# The desktop shell's icons ARE committed: the header of the app shows the
# icon of the app and the bundle needs them, so a clone without them cannot
# build. They are the ones the tool of Tauri generates:
#
#     bunx @tauri-apps/cli icon <source.png> -o crates/genmsi-app/src-tauri/icons
