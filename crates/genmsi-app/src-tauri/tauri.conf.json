{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GenMSI",
  "identifier": "org.gensmi.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GenMSI",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Education",
    "shortDescription": "Simulador GPSS",
    "longDescription": "GenMSI es un simulador de eventos discretos al estilo GPSS: se escribe un modelo con bloques, se corre y se ve la corrida reproducida, con sus gráficos y su reporte.",
    "copyright": "Lucas Cardozo",
    "publisher": "Lucas Cardozo"
  }
}
