===== QUERY tools/list =====
{
  "tools": [
    {
      "description": "See what the GenMSI desktop app is showing right now: the model it has open (`path`), whether the reader has changes that are not saved on it (`dirty`), what the app found in that model (`diagnostics`) and the last run the app made (`run`). It returns the genmsi.live/1 document, the one the app publishes; when the app is not running the document has `path: null` \u2014that is an answer, not a failure. Ask it BEFORE you write on the model the app has open: `apply_edit` and `save_model` refuse with `model_locked` while the app has unsaved changes on that model, so tell the reader to save it and send the same edit again.",
      "inputSchema": {
        "properties": {},
        "type": "object"
      },
      "name": "app_state"
    },
    {
      "description": "Add, edit and connect the blocks of a GenMSI model. The commands are the engine's own editing commands, the same ones the desktop application speaks: `addBlock` {class, container, x, y} creates a block of a catalogue class (call `catalogue` first: it gives the class names, their ports (ioid) and their properties), `connect` {from, fromIoid, to, toIoid} wires an output port to an input port, `setProperty` {id, property, value} sets a declared property, `setCaption` {id, caption} names a block, `moveBlock` {id, x, y} moves one, `removeBlock` {id} takes one away and `removeBlocks` {ids} takes several away as ONE operation; the schema of the tool carries the whole vocabulary. The commands are applied in order and the batch is ATOMIC: if one fails, none is applied and the failure names the command that failed. `layout` says where the blocks the batch adds go: `auto` (the default) puts every block an `addBlock` adds where there is room in its container, like a drop in the application; `explicit` uses the `x` and the `y` of the command. The model is checked before it is written: one that does not compile is NOT written, and the error names the block that caused it. The blocks the batch creates take the next free ids, in the order of the commands. Takes `path` (a .gmdl file) or `model` (the .gmdl document as text): `path` may be left out, and then the model the app has open is the one the batch edits; a `path` that is not on the disk yet is a model the batch CREATES, and the file is written when the model compiles. `target` says where the result goes: `file` (the default) writes it to the file the batch edited, and `proposal` leaves the model in the staging area of the app, without touching the disk, where the person sees it and decides to accept it or to discard it \u2014 the verdict comes back in `app_state`. `summary` is one line about what the batch did; it travels with the proposal. Returns the genmsi.edit/1 document.",
      "inputSchema": {
        "$defs": {
          "EditCommand": {
            "description": "One editing operation over the model.",
            "oneOf": [
              {
                "description": "Create a block of a catalogue class inside a container.",
                "properties": {
                  "class": {
                    "description": "Catalogue class (`Generate`, `Queue`, ...).",
                    "type": "string"
                  },
                  "container": {
                    "description": "Owning container id.",
                    "format": "uint32",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "op": {
                    "const": "addBlock",
                    "type": "string"
                  },
                  "x": {
                    "description": "Horizontal position.",
                    "format": "int32",
                    "type": "integer"
                  },
                  "y": {
                    "description": "Vertical position.",
                    "format": "int32",
                    "type": "integer"
                  }
                },
                "required": [
                  "op",
                  "class",
                  "container",
                  "x",
                  "y"
                ],
                "type": "object"
              },
              {
                "description": "Remove a block, its descendants and every link that touches them.",
                "properties": {
                  "id": {
                    "description": "Block id (the model root is refused).",
                    "format": "uint32",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "op": {
                    "const": "removeBlock",
                    "type": "string"
                  }
                },
                "required": [
                  "op",
                  "id"
                ],
                "type": "object"
              },
              {
                "description": "Remove several blocks as ONE operation.\n\nThe blocks that one of them owns are removed with it, and a block\nthat is already gone when its turn comes is skipped.",
                "properties": {
                  "ids": {
                    "description": "Block ids.",
                    "items": {
                      "format": "uint32",
                      "minimum": 0,
                      "type": "integer"
                    },
                    "type": "array"
                  },
                  "op": {
                    "const": "removeBlocks",
                    "type": "string"
                  }
                },
                "required": [
                  "op",
                  "ids"
                ],
                "type": "object"
              },
              {
                "description": "Move a block, keeping its size.",
                "properties": {
                  "id": {
                    "description": "Block id.",
                    "format": "uint32",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "op": {
                    "const": "moveBlock",
                    "type": "string"
                  },
                  "x": {
                    "description": "Horizontal position.",
                    "format": "int32",
                    "type": "integer"
                  },
                  "y": {
                    "description": "Vertical position.",
                    "format": "int32",
                    "type": "integer"
                  }
                },
                "required": [
                  "op",
                  "id",
                  "x",
                  "y"
                ],
                "type": "object"
              },
              {
                "description": "Set the position of many things as ONE operation (the re-layout).\n\nThe things are the blocks of the scope that was composed and the\ndoors of its container: a door is a block of the picture, and its\nplace is written like the place of any other block.",
                "properties": {
                  "op": {
                    "const": "setLayouts",
                    "type": "string"
                  },
                  "placements": {
                    "description": "One place per thing that was composed.",
                    "items": {
                      "$ref": "#/$defs/Placement"
                    },
                    "type": "array"
                  }
                },
                "required": [
                  "op",
                  "placements"
                ],
                "type": "object"
              },
              {
                "description": "Move a door of a container.\n\nA door is a block of the picture in its own right: the reader drags it\nwhere he wants it, and its place is kept.",
                "properties": {
                  "block": {
                    "description": "The container that owns the door.",
                    "format": "uint32",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "input": {
                    "description": "Whether the door is an entry one.",
                    "type": "boolean"
                  },
                  "ioid": {
                    "description": "The id of the door inside the container.",
                    "format": "uint32",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "op": {
