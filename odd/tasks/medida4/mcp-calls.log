  "glossary": {
    "Advance": "Delays the transaction by Media units of simulated time, plus Modificador for the deviation.",
    "Clock": "Control clock: creates a transaction every Frecuencia time units and ends the run when the counter reaches one.",
    "Depart": "Removes Cantidad transactions from the queue Queue, without using a facility.",
    "Enter": "Enters Cantidad units of the storage Storage.",
    "FacilityInt": "Preempts the facility Facility after Media units of time and waits in the queue Queue until it is free again.",
    "FacilityUse": "Uses the facility Facility for Media units of time; the transaction waits in the queue Queue while it is busy.",
    "Generate": "Creates transactions: Media is the mean time between them, Cantidad how many to create (leave it empty to create them forever; a number limits the total, and zero creates none), with the optional Modificador, OffSet and Prioridad.",
    "Leave": "Releases Cantidad units of the storage Storage.",
    "Priority": "Sets the priority of the transaction to Prioridad.",
    "QTable": "Declares a queue table.",
    "Queue": "The transaction joins the queue Queue; Cantidad units leave it.",
    "StorageDef": "Declares the capacity of a storage.",
    "StorageUse": "Takes Cantidad units of the storage Storage for Media units of time; the transaction waits in the queue Queue while the storage is full.",
    "Terminate": "Ends the run when Unidades transactions reach the statement (zero means the statement never fires).",
    "Transfer": "Sends the transaction to the next block with the probability Prob; the share goes to the first output."
  }
}

