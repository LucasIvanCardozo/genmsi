            "type": [
              "string",
              "null"
            ]
          },
          "summary": {
            "default": null,
            "description": "What the agent did, in one line.\n\nIt travels with the proposal, so the person reads it before deciding.",
            "type": [
              "string",
              "null"
            ]
          },
          "target": {
            "$ref": "#/$defs/Target",
            "description": "Where the model goes.\n\n`file` (the default) writes the model to the file it was named by;\n`proposal` leaves it in the staging area of the app, without touching\nthe disk, and the person decides."
          }
        },
        "type": "object"
      },
      "name": "save_model"
    },
    {
