                "const": "file",
                "description": "The model goes to the file it was named by.",
                "type": "string"
              },
              {
                "const": "proposal",
                "description": "The model goes to the staging area of the app: it does not touch the\ndisk, and the person decides.",
                "type": "string"
              }
            ]
