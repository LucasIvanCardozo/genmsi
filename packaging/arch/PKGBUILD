# Maintainer: Lucas Cardozo <lucasivancardozo27@gmail.com>
#
# GenMSI: simulador de eventos discretos al estilo GPSS.
#
# El bundle de Tauri no tiene un formato de pacman: el `.deb` es de la
# familia Debian y el `.rpm` de la Fedora, y ninguno de los dos sirve acá.
# Este PKGBUILD arma el paquete de Arch: el mismo programa, con las mismas
# dependencias del sistema (GTK 3 y WebKitGTK 4.1).
#
# La fuente es el tarball de la etiqueta del repositorio, con su suma real:
# la AUR no acepta `SKIP` y buida la fuente ella misma, en su propia
# máquina de construcción.
#
# Para armarlo desde el repositorio local (con el tarball del checkout, sin
# red):
#
#     packaging/arch/build-package.sh
#
# Para refrescar la suma cuando hay una versión nueva:
#
#     packaging/arch/aur-pkgbuild.sh
pkgname=genmsi
pkgver=0.3.2
pkgrel=1
pkgdesc="GenMSI: simulador de eventos discretos al estilo GPSS"
arch=('x86_64')
url="https://github.com/LucasIvanCardozo/genmsi"
license=('MIT')
depends=('gtk3' 'webkit2gtk-4.1')
# El build compila el frontend (bun) y el shell de escritorio (cargo), y
# el shell enlaza contra GTK 3 y WebKitGTK 4.1: por eso las dos librerías
# están también entre las dependencias de construcción (el `pkg-config` de
# cada una las pide al compilar, no sólo al correr).
makedepends=('rust' 'cargo' 'bun' 'patchelf' 'make' 'pkgconf' 'gtk3' 'webkit2gtk-4.1')
source=("$pkgname-$pkgver.tar.gz::https://github.com/LucasIvanCardozo/genmsi/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('f154af9c3a91201995785ffa6d10442ae864831b3917430796cd2528fae8522f')

build() {
  cd "$srcdir/$pkgname-$pkgver/crates/genmsi-app"
  # El frontend: el mismo que la app de escritorio arma.
  bun install --frozen-lockfile
  # El shell: el motor va dentro del programa y el frontend con él. El
  # bundle de Tauri no hace falta (el paquete de pacman no es su formato):
  # sólo se arma el programa.
  bunx @tauri-apps/cli build --no-bundle
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  install -Dm755 crates/genmsi-app/src-tauri/target/release/genmsi-app-desktop \
    "$pkgdir/usr/bin/genmsi-app-desktop"
  install -Dm644 packaging/linux/GenMSI.desktop \
    "$pkgdir/usr/share/applications/GenMSI.desktop"
  # El icono se instala con el nombre que pide el lanzador (Icon=GenMSI),
  # para que el menú del sistema lo muestre.
  install -Dm644 crates/genmsi-app/src-tauri/icons/128x128.png \
    "$pkgdir/usr/share/icons/hicolor/128x128/apps/GenMSI.png"
  install -Dm644 crates/genmsi-app/LEEME.txt \
    "$pkgdir/usr/share/doc/$pkgname/LEEME.txt"
}
